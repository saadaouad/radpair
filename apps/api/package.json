{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../packages/vitest-config/vitest.config.ts --project api-unit",
    "test:integration": "vitest run --config ../../packages/vitest-config/vitest.config.ts --project api-integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:placeholders": "tsx src/db/writePlaceholders.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@repo/contracts": "workspace:*",
    "@sentry/node": "^11.17.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "4.0.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "5.9.2",
    "vitest": "^4.1.12"
  }
}
